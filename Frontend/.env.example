# =============================================================================
# Genie Law — React Native frontend environment template
#
#   cp .env.example .env
#
# The real .env is gitignored. This template is committed, so it must never
# contain a secret. Nothing here is a secret: everything in a React Native
# bundle can be extracted from the APK, so no key that must stay private may
# ever live in this file. Server-side keys stay on the server.
# =============================================================================

# Base URL of the Genie Law backend, including the /api prefix and no trailing
# slash. Every request the app makes is built from this one value.
#
#   Deployed backend      https://<your-backend-domain>/api
#   Android emulator      http://10.0.2.2:5000/api    (10.0.2.2 is the host)
#   iOS simulator         http://localhost:5000/api
#   Physical device       http://<your-LAN-ip>:5000/api
#
# A plain http:// address additionally needs a cleartext exception on Android;
# see Frontend/README.md.
API_BASE_URL=http://10.0.2.2:5000/api

# How long a single request may take before it is reported as a timeout,
# in milliseconds.
API_TIMEOUT_MS=20000

# Public support contact shown on the About screen. Leave blank until you have
# a real, monitored address — blank hides the line rather than showing a
# placeholder. These are public by nature; never put a private value here.
SUPPORT_EMAIL=
SUPPORT_PHONE=

# The largest single AI upload (all documents + voice note together) the SERVER
# accepts, in MB. The app shows this on the AI Smart Assistant and refuses to
# send anything bigger, instead of failing with a confusing 413/CORS error.
#
# It must match nginx's `client_max_body_size` on the server. That is currently
# nginx's default of 1 MB. After raising it (recommended: 120m), set this to the
# new value — up to 110 (10 files x 10 MB + a 10 MB voice note) — and rebuild.
AI_UPLOAD_MAX_MB=1
