{
  "name": "Frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "node scripts/android-build.js",
    "android:release:clean": "node scripts/android-build.js --clean",
    "android:release:device": "node scripts/android-build.js --device",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "web": "vite build && vite preview --host 127.0.0.1 --port 5173",
    "web:build": "vite build",
    "web:preview": "vite preview --host 127.0.0.1 --port 5173",
    "web:watch": "vite build --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "node scripts/patch-audio-recorder-spec.js"
  },
  "dependencies": {
    "@bam.tech/react-native-image-resizer": "3.0.11",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native/metro-config": "^0.87.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@tanstack/react-query": "^5.103.1",
    "axios": "^1.20.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.87.1",
    "react-native-audio-recorder-player": "5.0.0-rc.1",
    "react-native-keychain": "^10.0.0",
    "react-native-reanimated": "^4.7.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "postcss": "^8.5.28",
    "prettier": "2.8.8",
    "react-native-dotenv": "^4.1.1",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
