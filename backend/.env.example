3# =============================================================================
# Backend environment template
#
# Copy this file to backend/.env and fill in the marked values:
#
#   cp .env.example .env
#
# Never commit the real .env — it is gitignored. This template is committed on
# purpose, so it must never contain a real secret.
#
# Lines marked  <-- MUST SET  have no safe default. The server either refuses
# to start or fails at the first request until you provide them.
# Everything else already carries a working local-development default.
# =============================================================================


# -----------------------------------------------------------------------------
# Required — the server exits at boot without these
#
# Checked by src/config/env.js before the port opens. A missing value prints
# "Cannot start: Missing required environment variable(s)" and exits 1.
# -----------------------------------------------------------------------------

# MongoDB connection string. The default points at a local mongod.
# For Atlas or a remote host, replace it with your own mongodb+srv://... URI.
#
# Note: src/config/db.js also accepts MONGODB_URI as a legacy alias, but the
# startup check only looks at MONGO_URI — setting the alias alone still fails.
# Always use MONGO_URI.
MONGO_URI=mongodb://127.0.0.1:27017/lawyer_app

# Secret used to sign and verify every JWT. No sign-in works without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates every issued token; all users must sign in again.
JWT_SECRET=                                        # <-- MUST SET


# -----------------------------------------------------------------------------
# Required for file uploads
# -----------------------------------------------------------------------------

# Public origin of this server, used to build the URLs stored against uploaded
# documents, profile photos and voice notes (src/services/storageService.js).
# Uploading throws "BACKEND_URL is not defined" when this is unset, so it is
# effectively required even though the boot check does not list it.
# Must be the address clients actually reach — not localhost in production.
BACKEND_URL=http://localhost:5000


# -----------------------------------------------------------------------------
# Core server settings — defaults are fine for local development
# -----------------------------------------------------------------------------

# Port the HTTP and Socket.IO server listens on. Defaults to 5000 if unset.
PORT=5000

# development | production
# "production" tightens CORS, switches request logging to combined format, and
# turns several warnings below into hard startup failures.
NODE_ENV=development

# How many reverse proxies sit in front of this server.
#
# A HOP COUNT, never `true` — `true` would trust a client-supplied
# X-Forwarded-For and let any caller spoof their address past the rate limiter.
#
#   0  nothing in front (local development)
#   1  nginx only                      <- the current EC2 deployment
#   2  load balancer in front of nginx <- set this when the ALB lands
#
# Leave it unset and the server infers 1 when NODE_ENV=production, which is how
# this behaved before the variable existed. Set it explicitly: a deployment whose
# .env still said NODE_ENV=development ran behind nginx with the proxy
# distrusted, so express-rate-limit counted every user as one client and logged
# ERR_ERL_UNEXPECTED_X_FORWARDED_FOR.
TRUST_PROXY=0

# Lifetime of an issued ACCESS token. Accepts a number with a unit: ms, s, m,
# h, d. Leave it set — an empty value issues tokens that never expire.
#
# Short by design: an access token cannot be revoked before it expires, so its
# lifetime is the window in which a signed-out or stolen token still works. The
# app renews it silently against /auth/refresh-token, so shortening this is not
# visible to users.
#
# Raise it only if you are deploying a server ahead of the app build that knows
# how to refresh; 7d was the old value and still works.
JWT_EXPIRES_IN=15m

# Lifetime of a device's REFRESH token, and so of its server-side session — how
# long a device stays signed in without re-entering a password.
#
# Each device holds its own, rotated on every use. Revoking one (logout, or
# /auth/logout-all) never touches another device's.
#
# When unset, sessions fall back to JWT_EXPIRES_IN, which is how a deployment
# that has not added this variable yet keeps its previous behaviour instead of
# silently expiring every session in fifteen minutes.
JWT_REFRESH_EXPIRES_IN=30d


# -----------------------------------------------------------------------------
# Required once NODE_ENV=production
# -----------------------------------------------------------------------------

# Comma-separated origins permitted by CORS. Ignored in development, where all
# origins are allowed. In production the boot check refuses to start while it is
# empty, because an empty allowlist rejects every request including the app's.
# e.g. ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=                                   # <-- MUST SET in production

# Key for encrypting sensitive fields at rest (bank details, UPI ids).
# Falls back to JWT_SECRET when unset. In production the server refuses to start
# unless one of the two is set, rather than using a development key.
# Changing it makes everything already encrypted unreadable, so set it once.
# Generate it the same way as JWT_SECRET.
ENCRYPTION_SECRET=                                 # <-- MUST SET in production


# -----------------------------------------------------------------------------
# Initial admin account
#
# Used only by the explicit seeding command, never on a normal boot:
#   npm run seed:admin
# An account that already exists is never modified — its password, role and
# status are left alone.
# -----------------------------------------------------------------------------

# Defaults to admin@lawconnect.com if unset.
ADMIN_EMAIL=admin@lawconnect.com

# In development, leaving this blank generates a random password and prints it
# once. In production a blank value skips seeding entirely with a warning, so
# set it before seeding a live deployment.
ADMIN_PASSWORD=                                    # <-- MUST SET in production

# Mobile number on the seeded admin account. Defaults to +10000000000 if unset.
ADMIN_MOBILE=


# -----------------------------------------------------------------------------
# Optional integrations — the server runs without every value below.
# Each one disables or degrades exactly one feature when left blank.
# -----------------------------------------------------------------------------

# Google Gemini key, used by AI Smart Case analysis and the AI assistant.
# Without it those endpoints are unavailable and the server warns at boot.
GEMINI_API_KEY=

# Google Places key for city/location autocomplete.
# Without it the server falls back to Photon (OpenStreetMap), which needs no
# key. Set it for better ranking and alias handling ("Bangalore").
# Enable "Places API" on the project and restrict the key by IP to this server.
# This key must stay server-side — never put it in the Flutter .env, which is
# bundled into the APK and can be extracted.
GOOGLE_PLACES_API_KEY=

# Google Calendar integration for lawyer availability sync. Without the client
# id and secret the "Connect Google Calendar" action reports the feature as
# unavailable. GOOGLE_REDIRECT_URI defaults to urn:ietf:wg:oauth:2.0:oob.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Redis connection string, e.g. redis://127.0.0.1:6379
# Caching currently runs in-process regardless: src/config/redis.js always uses
# the in-memory store and only logs that this value was seen. Set it for the
# docker-compose redis service and for when the client is wired up.
REDIS_URL=


# -----------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# -----------------------------------------------------------------------------
# PAYMENT_MODE: 'sandbox' (default for testing/development) or 'live'
# In 'live' mode, missing credentials or invalid signatures fail closed.
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

