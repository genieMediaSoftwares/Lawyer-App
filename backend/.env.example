3# =============================================================================
# Always use MONGO_URI.
MONGO_URI=mongodb://127.0.0.1:27017/lawyer_app
JWT_SECRET=                                        # <-- MUST SET
BACKEND_URL=http://localhost:5000
PORT=5000
NODE_ENV=development
TRUST_PROXY=0
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# production, http://localhost:* and http://127.0.0.1:* are always allowed.
# Example for the local web preview against the deployed API:
#   ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
ALLOWED_ORIGINS=                                   # <-- MUST SET in production

# AI Smart Case Assistant file limits, in MB.
# AI_UPLOAD_MAX_MB   largest document accepted, after optimization.
# AI_OPTIMIZE_MAX_MB largest original accepted by POST /api/ai/smart-case/optimize
#                    only, to be shrunk to AI_UPLOAD_MAX_MB. nginx must allow
#                    this size on that one location (deploy/nginx/README.md).
AI_UPLOAD_MAX_MB=3
AI_OPTIMIZE_MAX_MB=20
# Ghostscript binary used to optimize PDFs. Leave blank to use `gs` on PATH.
GHOSTSCRIPT_PATH=
ENCRYPTION_SECRET=                                 # <-- MUST SET in production
ADMIN_EMAIL=admin@lawconnect.com
ADMIN_PASSWORD=                                    # <-- MUST SET in production
# Mobile number on the seeded admin account. Defaults to +10000000000 if unset.
ADMIN_MOBILE=
# Google Gemini key, used by AI Smart Case analysis and the AI assistant.
GEMINI_API_KEY=
# Google Places key for city/location autocomplete.
GOOGLE_PLACES_API_KEY=
# Google Calendar integration for lawyer availability sync. Without the client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Redis connection string, e.g. redis://127.0.0.1:6379
REDIS_URL=
# Razorpay Payment Gateway Configuration
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=