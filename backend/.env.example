# # Copy to .env and fill in. Never commit the real .env — it is gitignored.

# PORT=5000
# BACKEND_URL=http://localhost:5000

# # development | production
# NODE_ENV=development

# # Comma-separated origins permitted by CORS when NODE_ENV=production.
# # Ignored in development, where all origins are allowed.
# # e.g. ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# ALLOWED_ORIGINS=

# MONGO_URI=mongodb://127.0.0.1:27017/lawyer_app

# # Generate with:
# #   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# # Changing this invalidates every issued token; all users must sign in again.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# # Initial admin account, created only if no account with ADMIN_EMAIL exists.
# # Required in production — without ADMIN_PASSWORD no admin is seeded.
# # In development a random password is generated and printed once.
# ADMIN_EMAIL=admin@lawconnect.com
# ADMIN_PASSWORD=
# ADMIN_MOBILE=

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# # Google Places API key for city/location autocomplete.
# # OPTIONAL: without it the server falls back to Photon (OpenStreetMap), which
# # needs no key. Set it for better ranking and alias handling ("Bangalore").
# # Enable "Places API" on the project and restrict the key by IP to this server.
# # This key must stay server-side — never put it in the Flutter .env, which is
# # bundled into the APK and can be extracted.
# GOOGLE_PLACES_API_KEY=

# GEMINI_API_KEY=

# # Key for encrypting sensitive fields at rest (bank details, UPI ids).
# # REQUIRED in production — the server refuses to start without it or JWT_SECRET.
# # Changing it makes everything already encrypted unreadable, so set it once.
# ENCRYPTION_SECRET=

# # Google Calendar integration for lawyer availability sync. OPTIONAL: without
# # these the "Connect Google Calendar" action reports the feature as unavailable.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# # Redis connection for caching. OPTIONAL: the server falls back to in-process
# # behaviour when unset. e.g. REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=
